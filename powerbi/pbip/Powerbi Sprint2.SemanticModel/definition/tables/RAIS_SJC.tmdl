		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 🚗 Automotivo
	/// 
	measure 'Estab Transporte de Carga' = CALCULATE(COUNTROWS('RAIS_SJC'), 'RAIS_SJC'[CNAE 2.0 Classe] = "49302", REMOVEFILTERS('RAIS_SJC'[Categoria Automotiva]))
		formatString: 0
