	partition RAIS_SJC = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\Users\thaly\Downloads\RAIS_SJC.csv"),[Delimiter=";", Columns=24, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Usar a Primeira Linha como Cabeçalho" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    #"Alterar Tipo" = Table.TransformColumnTypes(#"Usar a Primeira Linha como Cabeçalho",{{"Bairros SP", Int64.Type}, {"Bairros Fortaleza", Int64.Type}, {"Bairros RJ", Int64.Type}, {"CNAE 2.0 Classe", Int64.Type}, {"CNAE 95 Classe", Int64.Type}, {"Distritos SP", Int64.Type}, {"Qtd Vínculos CLT", Int64.Type}, {"Qtd Vínculos Ativos", Int64.Type}, {"Qtd Vínculos Estatutários", Int64.Type}, {"Ind Atividade Ano", Int64.Type}, {"Ind CEI Vinculado", Int64.Type}, {"Ind Estab Participa PAT", Int64.Type}, {"Ind Rais Negativa", Int64.Type}, {"Ind Simples", Int64.Type}, {"Município", Int64.Type}, {"Natureza Jurídica", Int64.Type}, {"Regiões Adm DF", Int64.Type}, {"CNAE 2.0 Subclasse", Int64.Type}, {"Tamanho Estabelecimento", Int64.Type}, {"Tipo Estab", Int64.Type}, {"Tipo Estab_1", type text}, {"UF", Int64.Type}, {"IBGE Subsetor", Int64.Type}, {"CEP Estab", Int64.Type}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Alterar Tipo",{{"Município", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Bairros SP", "Bairros Fortaleza", "Bairros RJ", "Distritos SP", "Regiões Adm DF"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Removidas",{{"CNAE 2.0 Classe", type text}, {"CNAE 95 Classe", type text}, {"Qtd Vínculos CLT", Int64.Type}, {"CNAE 2.0 Subclasse", type text}, {"Natureza Jurídica", type text}, {"UF", type text}, {"CEP Estab", type text}, {"Ind Atividade Ano", type text}, {"Ind CEI Vinculado", type text}, {"Ind Estab Participa PAT", type text}, {"Ind Rais Negativa", type text}, {"Ind Simples", type text}, {"Tamanho Estabelecimento", type text}, {"Tipo Estab", type text}, {"IBGE Subsetor", type text}}),
				    #"Personalização Adicionada" = Table.AddColumn(#"Tipo Alterado1", "Situação Vínculo", each if [Ind Rais Negativa] = "0" then "Com Vínculo" else "Sem Vínculo"),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Personalização Adicionada",{{"Situação Vínculo", type text}}),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Tipo Alterado2", "Setor", each if [CNAE 2.0 Classe] = "86305" then "Atenção ambulatorial (médicos/odontólogos)"
				else if [CNAE 2.0 Classe] = "56112" then "Restaurantes e alimentação"
				else if [CNAE 2.0 Classe] = "82113" then "Serviços de escritório e apoio administrativo"
				else if [CNAE 2.0 Classe] = "85996" then "Ensino não especificado"
				else if [CNAE 2.0 Classe] = "86500" then "Profissionais de saúde (exceto médicos)"
				else if [CNAE 2.0 Classe] = "81125" then "Condomínios prediais"
				else if [CNAE 2.0 Classe] = "73190" then "Publicidade"
				else if [CNAE 2.0 Classe] = "47814" then "Comércio varejista de vestuário"
				else if [CNAE 2.0 Classe] = "71120" then "Serviços de engenharia"
				else if [CNAE 2.0 Classe] = "49302" then "Transporte rodoviário de carga"
				else if [CNAE 2.0 Classe] = "30415" then "Fabricação de aeronaves"
				else if [CNAE 2.0 Classe] = "86101" then "Atendimento hospitalar"
				else if [CNAE 2.0 Classe] = "47113" then "Hipermercados e supermercados"
				else if [CNAE 2.0 Classe] = "82202" then "Teleatendimento (call center)"
				else if [CNAE 2.0 Classe] = "81117" then "Serviços de apoio a edifícios"
				else if [CNAE 2.0 Classe] = "29107" then "Fabricação de automóveis"
				else [CNAE 2.0 Classe]),
				    #"Tipo Alterado3" = Table.TransformColumnTypes(#"Personalização Adicionada1",{{"Setor", type text}}),
				    #"Personalização Adicionada2" = Table.AddColumn(#"Tipo Alterado3", "Categoria Automotiva", each if Text.StartsWith([CNAE 2.0 Classe], "29") then "Fabricação de Veículos (Fábricas)"
				else if Text.StartsWith([CNAE 2.0 Classe], "45") then "Comércio/Reparação de Veículos"
				else "Outro Setor"),
				    #"Tipo Alterado4" = Table.TransformColumnTypes(#"Personalização Adicionada2",{{"Categoria Automotiva", type text}}),
				    #"Personalização Adicionada3" = Table.AddColumn(#"Tipo Alterado4", "Faixa de Porte", each if [Tamanho Estabelecimento] = "1" then "Zero"
				else if [Tamanho Estabelecimento] = "2" then "1 a 4"
				else if [Tamanho Estabelecimento] = "3" then "5 a 9"
				else if [Tamanho Estabelecimento] = "4" then "10 a 19"
				else if [Tamanho Estabelecimento] = "5" then "20 a 49"
				else if [Tamanho Estabelecimento] = "6" then "50 a 99"
				else if [Tamanho Estabelecimento] = "7" then "100 a 249"
				else if [Tamanho Estabelecimento] = "8" then "250 a 499"
				else if [Tamanho Estabelecimento] = "9" then "500 a 999"
				else if [Tamanho Estabelecimento] = "10" then "1000 ou mais"
				else "Não informado"),
				    #"Personalização Adicionada4" = Table.AddColumn(#"Personalização Adicionada3", "Ordem Porte", each Number.From([Tamanho Estabelecimento])),
				    #"Tipo Alterado5" = Table.TransformColumnTypes(#"Personalização Adicionada4",{{"Ordem Porte", Int64.Type}, {"Faixa de Porte", type text}}),
				    #"Personalização Adicionada5" = Table.AddColumn(#"Tipo Alterado5", "Natureza Nome", each if [Natureza Jurídica] = "2062" then "Sociedade Empresária Limitada" else if [Natureza Jurídica] = "2135" then "Empresário Individual" else if [Natureza Jurídica] = "2054" then "Sociedade Anônima Fechada" else if [Natureza Jurídica] = "2046" then "Sociedade Anônima Aberta" else if [Natureza Jurídica] = "2038" then "Sociedade de Economia Mista" else if [Natureza Jurídica] = "2143" then "Cooperativa" else if [Natureza Jurídica] = "2240" then "Sociedade Simples Limitada" else if [Natureza Jurídica] = "3999" then "Associação Privada" else if [Natureza Jurídica] = "3220 " then "Organização Religiosa" else if [Natureza Jurídica] = "3085" then "Condomínio Edilício" else if [Natureza Jurídica] = "2240" then "Sociedade Simples Limitada" else if [Natureza Jurídica] = "2232" then "Sociedade Simples Pura" else [Natureza Jurídica]),
				    #"Personalização Adicionada6" = Table.AddColumn(#"Personalização Adicionada5", "Atividade Automotiva", each if [CNAE 2.0 Classe] = "29107" then "Fabricação de automóveis, camionetas e utilitários"
				else if [CNAE 2.0 Classe] = "29301" then "Cabines, carrocerias e reboques"
				else if [CNAE 2.0 Classe] = "29417" then "Peças para sistema motor"
				else if [CNAE 2.0 Classe] = "29433" then "Peças para sistema de freios"
				else if [CNAE 2.0 Classe] = "29441" then "Peças para direção e suspensão"
				else if [CNAE 2.0 Classe] = "29492" then "Outras peças e acessórios"
				else if [CNAE 2.0 Classe] = "29506" then "Recondicionamento de motores"
				else if [CNAE 2.0 Classe] = "45111" then "Comércio de veículos automotores"
				else if [CNAE 2.0 Classe] = "45129" then "Representantes comerciais de veículos"
				else if [CNAE 2.0 Classe] = "45200" then "Manutenção e reparação de veículos"
				else if [CNAE 2.0 Classe] = "45307" then "Comércio de peças e acessórios"
				else if [CNAE 2.0 Classe] = "45412" then "Comércio de motocicletas, peças e acessórios"
				else if [CNAE 2.0 Classe] = "45421" then "Representantes comerciais de motocicletas"
				else if [CNAE 2.0 Classe] = "45439" then "Manutenção e reparação de motocicletas"
				else null),
				    #"Tipo Alterado6" = Table.TransformColumnTypes(#"Personalização Adicionada6",{{"Atividade Automotiva", type text}}),
				    #"Personalização Adicionada7" = Table.AddColumn(#"Tipo Alterado6", "Seção CNAE", each let
				  d = try Number.From(Text.Start(Text.PadStart(Text.From([CNAE 2.0 Classe]), 5, "0"), 2)) otherwise 0,
				  lim = {3,9,33,35,39,43,47,53,56,63,66,68,75,82,84,85,88,93,96,97,99},
				  nomes = {"A - Agricultura e pecuária","B - Indústrias extrativas","C - Indústrias de transformação","D - Eletricidade e gás","E - Água, esgoto e resíduos","F - Construção","G - Comércio e reparação de veículos","H - Transporte e armazenagem","I - Alojamento e alimentação","J - Informação e comunicação","K - Atividades financeiras e seguros","L - Atividades imobiliárias","M - Atividades profissionais e técnicas","N - Atividades administrativas","O - Administração pública","P - Educação","Q - Saúde e serviços sociais","R - Artes, cultura e esporte","S - Outros serviços","T - Serviços domésticos","U - Organismos internacionais"},
				  pos = List.PositionOf(List.Transform(lim, each d <= _), true)
				in
				  if d = 0 or pos = -1 then "Não classificado" else nomes{pos}),
				    #"Tipo Alterado7" = Table.TransformColumnTypes(#"Personalização Adicionada7",{{"Seção CNAE", type text}}),
				    Chave = Table.AddColumn(#"Tipo Alterado7", "Classe Chave", each Text.PadStart(Text.From([CNAE 2.0 Classe]), 5, "0"), type text),
				    Mesclar = Table.NestedJoin(Chave, {"Classe Chave"}, dCNAE, {"Classe"}, "dCNAE", JoinKind.LeftOuter),
				    Expandir = Table.ExpandTableColumn(Mesclar, "dCNAE", {"Classe_Descricao"}, {"Classe Descrição"}),
				    SetorCompleto = Table.AddColumn(Expandir, "Setor Completo", each if [Setor] = [CNAE 2.0 Classe] then [Classe Descrição] else [Setor], type text)
				in
				    SetorCompleto

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

