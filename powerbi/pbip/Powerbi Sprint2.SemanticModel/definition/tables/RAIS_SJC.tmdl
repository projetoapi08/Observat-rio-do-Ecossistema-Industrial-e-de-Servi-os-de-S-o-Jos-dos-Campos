		formatString: 0
		displayFolder: 🚗 Automotivo
		lineageTag: 2a544fd7-c5af-44af-914b-e6c61c0180a8

	measure '% Participação Estab' = DIVIDE([Total de Estabelecimentos], CALCULATE([Total de Estabelecimentos], ALL('RAIS_SJC'[Seção CNAE])))
