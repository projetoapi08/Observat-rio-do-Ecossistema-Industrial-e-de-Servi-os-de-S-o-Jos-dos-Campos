		displayFolder: 📊 Medidas
		lineageTag: 7cfc4f4e-5c67-4e8b-bc37-4f4996539a41

	measure '% Com Vínculo' = DIVIDE([Estabelecimentos Com Vínculo], [Total de Estabelecimentos])
