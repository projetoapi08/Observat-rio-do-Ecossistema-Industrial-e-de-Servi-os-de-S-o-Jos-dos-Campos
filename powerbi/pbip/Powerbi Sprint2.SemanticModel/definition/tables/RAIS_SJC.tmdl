table RAIS_SJC
	lineageTag: cddf2c55-ed76-46a0-951f-8fd7a07d1294

	measure 'Total de Estabelecimentos' = COUNTROWS('RAIS_SJC')
		formatString: 0
		displayFolder: 📊 Medidas
		lineageTag: 21373d60-25a7-4e35-96b9-3d1b33fbdbdc

	measure 'Estabelecimentos Com Vínculo' = CALCULATE(COUNTROWS('RAIS_SJC'), 'RAIS_SJC'[Situação Vínculo] = "Com Vínculo")
