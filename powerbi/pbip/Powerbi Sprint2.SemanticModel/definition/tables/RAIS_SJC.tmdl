		displayFolder: 🚗 Automotivo
		lineageTag: 6e77f29d-db75-4779-9026-abd9dc18e398

	/// 🚗 Automotivo
	/// 
	measure 'Vínculos Comércio e Reparação' = CALCULATE([Total Vínculos CLT], 'RAIS_SJC'[Categoria Automotiva] = "Comércio/Reparação de Veículos")
		formatString: 0
		displayFolder: 🚗 Automotivo
		lineageTag: 1f50bf9a-6c20-47f9-b52a-1890f5bb7bd9

