model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["RAIS_SJC","Cruzamento","PIB anual","VAB setorial","CEP x Região","dCNAE"]

annotation PBI_ProTooling = ["DevMode"]

ref table RAIS_SJC
ref table Cruzamento
ref table 'PIB anual'
ref table 'VAB setorial'
ref table 'CEP x Região'
ref table dCNAE

ref cultureInfo pt-BR

